[Unit]
Description=Emergency MQTT Notification Service
# mosquitto.service is a confirmed unit name on this image (verified
# running), unlike the still-unverified ubus broker unit name (see
# research/dnevnik-odluka.md D15). Wants= on either is still safe if a name
# turns out wrong: systemd silently ignores After=/Wants= on a nonexistent
# unit. Restart=on-failure below is the real safety net regardless.
After=ubus.service mosquitto.service
Wants=ubus.service mosquitto.service

# Log files go to the persistent data partition, which systemd mounts as its
# own unit. Without this the service could start before that mount exists, in
# which case the log directory cannot be created and logging silently falls
# back to standard output.
RequiresMountsFor=/run/media/data-mmcblk0p9

[Service]
Type=simple
# Broker address comes from the environment, so pointing this service at a
# broker on another machine is a configuration change, not a rebuild. The
# leading dash makes the file optional: without it the service falls back to
# localhost:1883.
EnvironmentFile=-/etc/emergency/mqtt.env
ExecStart=/usr/bin/emergency-mqtt-service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
