# Adresa posrednika poruka za emergency-mqtt-service.
#
# Podrazumevano je posrednik na samom uredjaju. Za isporuku ka drugom uredjaju
# dovoljno je promeniti ove dve vrednosti i ponovo pokrenuti servis:
#
#     systemctl restart emergency-mqtt-service
#
# Izvorni kod se pri tome ne menja.

EMERGENCY_MQTT_HOST=localhost
EMERGENCY_MQTT_PORT=1883
