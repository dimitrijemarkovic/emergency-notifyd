[Unit]
Description=Emergency LED Service
# Exact ubusd unit name on this image is unverified -- After=/Wants= on a
# nonexistent unit is silently ignored by systemd, so this is safe even if the
# name is wrong.
# Restart=on-failure below is the real safety net regardless.
After=ubus.service
Wants=ubus.service

# Log files go to the persistent data partition, which systemd mounts as its
# own unit. Without this the service could start before that mount exists, in
# which case the log directory cannot be created and logging silently falls
# back to standard output.
RequiresMountsFor=/run/media/data-mmcblk0p9

[Service]
Type=simple
ExecStart=/usr/bin/emergency-led-service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
